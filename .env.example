# FarmWise Backend Configuration Template
# Copy this file to .env inside backend/ or project root

# Application Settings
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
DATA_MODE=synthetic_demo

# Optional Groq LLM API Settings
# If left empty, FarmWise operates seamlessly in deterministic rule-based demo mode
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=12.0

# CORS Allowed Origins (JSON array or comma-separated list)
# Default allows Vite frontend on port 5173 and Next.js on 3000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","*"]
