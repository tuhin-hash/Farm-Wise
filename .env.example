# FarmWise Backend Configuration Template
# Copy this file to .env inside backend/ or project root

# Application Settings
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
DATA_MODE=synthetic_demo

# Optional Groq LLM & Whisper Speech API Settings
# If left empty, FarmWise operates seamlessly in deterministic rule-based demo mode
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_AUDIO_MODEL=whisper-large-v3
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=12.0

# Notification & SMS Gateway Settings (India / Demo / MSG91 / Twilio)
SMS_PROVIDER=twilio
SMS_API_KEY=3GDVLLVF9SGYGA2H447GJNNR
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=3GDVLLVF9SGYGA2H447GJNNR
TWILIO_FROM_NUMBER=+15005550006
SMS_SENDER_ID=FARMWI
SMS_TEMPLATE_ID=
SMS_DEFAULT_COUNTRY_CODE=+91
SMS_COOLDOWN_HOURS=6

# CORS Allowed Origins (JSON array or comma-separated list)
# Default allows Vite frontend on port 5173 and Next.js on 3000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","*"]
